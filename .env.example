# AI API (Native Google Gemini)
AI_PROVIDER=gemini
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_API_KEY=your-gemini-api-key-here

# Models
AI_MODEL_NORMAL=gemini-3.8-flash
AI_MODEL_WATCH=gemini-4-hydrogen
AI_MODEL_CRITICAL=gemini-4-hydrogen

# MetaTrader 5 (Windows only)
MT5_LOGIN=12345678
MT5_PASSWORD=your_password
MT5_SERVER=YourBroker-Demo

# Logging
LOG_LEVEL=INFO
