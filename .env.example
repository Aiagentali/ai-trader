# AI API (OrcRouter — OpenAI-compatible)
AI_API_KEY=your-key-here
AI_BASE_URL=https://api.orcarouter.ai/v1
AI_PROVIDER=openai-compat

# Model to use (must be available on your provider)
AI_MODEL_NORMAL=openai/gpt-4o-mini
AI_MODEL_CRITICAL=openai/gpt-4o

# MetaTrader 5 (Windows only)
MT5_LOGIN=12345678
MT5_PASSWORD=your_password
MT5_SERVER=YourBroker-Demo

# Logging
LOG_LEVEL=INFO
